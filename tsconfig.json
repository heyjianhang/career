{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
