        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "salary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "inbox",
            "preparing",
            "applied",
            "interviewing",
            "offer",
            "ended",
            "contacting",
            "archived"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "enum": [
                  "boss",
                  "liepin",
                  "job51",
                  "zhaopin",
                  "website",
                  "referral",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "http-url"
              },
              "native_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "platform"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "next_action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
