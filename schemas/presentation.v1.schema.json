{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "career-presentation/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "synthetic": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "resume_id",
        "files"
      ]
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "url": {
                "$ref": "#/definitions/webUrl"
              }
            },
            "required": [
              "label",
              "value"
            ]
          },
          "minItems": 0,
          "maxItems": 200
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,79}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "subtitle": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "period": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "paragraphs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      },
                      "minItems": 0,
                      "maxItems": 200
                    },
                    "bullets": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      },
                      "minItems": 0,
                      "maxItems": 200
                    },
                    "links": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "$ref": "#/definitions/webLink"
                      },
                      "description": "此经历可展示的项目、演示、源码或作品链接；没有则省略或传空数组。"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "paragraphs",
                    "bullets"
                  ]
                },
                "minItems": 1,
                "maxItems": 200
              }
            },
            "required": [
              "id",
              "title",
              "items"
            ]
          },
          "minItems": 1,
          "maxItems": 200
        },
        "photo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "alt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "position": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      },
      "required": [
        "name",
        "headline",
        "contacts",
        "summary",
        "sections"
      ]
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boss": {
          "$ref": "#/definitions/report"
        },
        "zhaopin": {
          "$ref": "#/definitions/report"
        },
        "liepin": {
          "$ref": "#/definitions/report"
        },
        "job51": {
          "$ref": "#/definitions/report"
        }
      },
      "required": []
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "description": "各平台共用的技能、证书、语言等资料。一次整理，用户自行匹配平台选项；求职期望另行维护。",
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "url": {
                      "$ref": "#/definitions/webUrl"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "generated_at",
    "synthetic",
    "source",
    "resume",
    "reports"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "kind": {
                "enum": [
                  "summary",
                  "employment",
                  "project",
                  "education"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,79}$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                },
                "minItems": 1,
                "maxItems": 200
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "fields"
            ]
          },
          "minItems": 1,
          "maxItems": 200
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "sections",
        "notes"
      ]
    },
    "webUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[hH][tT][tT][pP][sS]?://",
      "description": "完整的 HTTP(S) 网址，不含空格或登录凭据；无链接时省略，不使用空字符串。"
    },
    "webLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "$ref": "#/definitions/webUrl"
        }
      },
      "required": [
        "label",
        "url"
      ]
    }
  }
}
