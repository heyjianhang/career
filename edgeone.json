{
  "name": "career",
  "installCommand": "node --version",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "build/site",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/*",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
