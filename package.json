{
  "name": "@heyjianhang/career",
  "version": "0.2.0",
  "description": "与 Agent 协作的个人求职工作台：整理经历、准备简历，逐步连接岗位分析与求职跟踪。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyjianhang/career.git"
  },
  "homepage": "https://github.com/heyjianhang/career#readme",
  "bugs": {
    "url": "https://github.com/heyjianhang/career/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "check": "node scripts/validate.mjs",
    "check:example": "node scripts/validate.mjs --workspace examples/fictional-operations",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-presentation-assets.mjs && node scripts/package-resources.mjs",
    "pretest": "npm run build",
    "demo": "npm run build && node scripts/prepare-presentation-demo.mjs && node dist/cli.js resume preview --workspace .cache/demo-workspace --open",
    "test:presentation": "npm run build && node --test tests/presentation.test.mjs",
    "test:browser": "npm run build && node tests/presentation-browser.mjs",
    "test:templates": "npm run build && node tests/templates-browser.mjs",
    "test:layout": "npm run build && node tests/layout-browser.mjs",
    "test:links": "npm run build && node tests/links-browser.mjs",
    "prepack": "npm run build",
    "test:distribution": "npm run build && node --test tests/distribution.test.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "career": "node dist/cli.js",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "test:board": "npm run build && node tests/board-browser.mjs",
    "test:resumes": "npm run build && node tests/resume-library-browser.mjs",
    "test:profile": "npm run build && node tests/profile-browser.mjs",
    "test:company": "npm run build && node tests/company-browser.mjs",
    "test:sync": "npm run build && node tests/sync-browser.mjs",
    "test:workspaces": "npm run build && node tests/workspace-settings-browser.mjs",
    "desktop:icons": "node scripts/desktop/icons.mjs",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:dev": "node scripts/desktop/dev.mjs",
    "desktop:build": "node scripts/desktop/build.mjs",
    "desktop:mac:arm64": "npm run desktop:build -- --platform mac --arch arm64",
    "desktop:mac:x64": "npm run desktop:build -- --platform mac --arch x64",
    "desktop:win:x64": "npm run desktop:build -- --platform win --arch x64",
    "desktop:win:arm64": "npm run desktop:build -- --platform win --arch arm64",
    "desktop:test": "node scripts/desktop/test.mjs",
    "build:agent-roadmap": "node scripts/build-agent-roadmap.mjs",
    "test:agent-roadmap": "node tests/agent-roadmap-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "ajv": "8.20.0",
    "markdown-it": "15.0.2",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "yaml": "2.9.1"
  },
  "bin": {
    "career": "dist/cli.js"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "bootstrap-icons": "1.13.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "files": [
    "dist/",
    "resources/",
    "scripts/init.mjs",
    "scripts/paths.mjs",
    "scripts/records.mjs",
    "scripts/validate.mjs",
    "scripts/hash.mjs",
    "scripts/freeze.mjs",
    ".agents/skills/career-setup/",
    ".agents/skills/career-git/",
    ".agents/skills/career-intake/",
    ".agents/skills/career-employment/",
    ".agents/skills/career-project/",
    ".agents/skills/resume-master/",
    ".agents/skills/resume-tailor/",
    ".agents/skills/career-board/",
    "templates/context/",
    "schemas/",
    "examples/presentation/package.json",
    "docs/installation.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
